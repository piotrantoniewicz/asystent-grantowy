// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  emailVerified          DateTime?
  createdAt              DateTime  @default(now())
  freeQuestionsUsed      Int      @default(0)
  paidQuestionsRemaining Int      @default(0)

  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
  purchases     Purchase[]
  savedSources  SavedSource[]
}

// Tabele wymagane przez Auth.js (adapter Prisma)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]
  scrapedSources ScrapedSource[]

  @@index([userId, updatedAt])
}

enum MessageRole {
  user
  assistant
}

model Message {
  id                       String      @id @default(cuid())
  conversationId           String
  role                     MessageRole
  content                  String
  modelUsed                String?
  inputTokens              Int?
  outputTokens             Int?
  cacheCreationInputTokens Int?
  cacheReadInputTokens     Int?
  // Pomiary jednej odpowiedzi. Trzymamy je w bazie, bo logi Vercela znikają
  // po godzinie — bez tego nie da się zebrać rozkładu z kilku dni
  // (patrz `dokumentacja-aplikacja-granty/19-backlog-optymalizacji.md`, zadanie 2).
  toolRounds               Int?
  firstTextMs              Int?
  totalMs                  Int?
  createdAt                DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([role, createdAt])
}

enum ScrapedSourceKind {
  organization
  grant
}

enum ScrapedSourceStatus {
  pending
  done
  error
}

model ScrapedSource {
  id             String              @id @default(cuid())
  conversationId String
  kind           ScrapedSourceKind
  rootUrl        String
  status         ScrapedSourceStatus @default(pending)
  summary        String?
  // Gotowy, przycięty kawałek promptu z treścią tego źródła — składany raz po
  // scrapowaniu (`buildSourceContext`). Dzięki temu przy każdym pytaniu czytamy
  // jeden wiersz zamiast wszystkich stron. Puste dla źródeł sprzed tej zmiany
  // — wtedy `chat/route.ts` składa go w locie i uzupełnia.
  contextBlob    String?
  // Spis stron (JSON) dla trybu „dokumentacja na żądanie" — tytuł, adres
  // i początek każdej strony, bez pełnej treści (`buildSourceIndex`). Treść
  // model dobiera sobie narzędziami. Puste dla źródeł sprzed tej zmiany —
  // wtedy `chat/route.ts` składa spis w locie i uzupełnia w tle.
  indexBlob      String?
  createdAt      DateTime            @default(now())

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  pages        ScrapedPage[]

  @@index([conversationId])
  @@index([rootUrl])
}

enum ScrapedPageContentType {
  html
  pdf
}

model ScrapedPage {
  id          String                 @id @default(cuid())
  sourceId    String
  url         String
  contentType ScrapedPageContentType
  title       String
  textContent String
  createdAt   DateTime               @default(now())

  source ScrapedSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

enum PurchaseStatus {
  pending
  paid
  failed
}

model Purchase {
  id               String         @id @default(cuid())
  userId           String
  stripeSessionId  String?        @unique
  packageName      String
  questionsGranted Int
  amountPln        Int
  status           PurchaseStatus @default(pending)
  createdAt        DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedSource {
  id         String   @id @default(cuid())
  userId     String
  kind       String // "organization" | "grant"
  rootUrl    String
  name       String
  summary    String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, rootUrl])
  @@index([userId, lastUsedAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model FreeQuota {
  id        String   @id            // "device:<uuid>" lub "ip:<hash>:<RRRR-MM-DD>"
  used      Int      @default(0)
  updatedAt DateTime @updatedAt
}
